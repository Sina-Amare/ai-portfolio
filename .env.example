# Copy to .env.local and fill in. Every variable the code reads is listed here.
# All of them are server-side only (never sent to the browser), except NEXT_PUBLIC_SITE_URL.

# ── Chat (RAG) ────────────────────────────────────────────────────────────────

# Google AI Studio key — embeddings (gemini-embedding-001) + chat (Gemini 3.1/2.5 Flash).
# Required: without it the chatbot can't embed questions.
# Get one free (no card): https://aistudio.google.com/app/apikey
# Tip: put SEVERAL keys comma-separated to multiply your quota — the chat ladder
# rotates across them and fails over when one is exhausted. e.g. KEY1,KEY2,KEY3
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq — fastest time-to-first-token, leads the chat ladder for English. Recommended.
# Get one free (no card): https://console.groq.com/keys  (also supports comma-separated keys)
GROQ_API_KEY=

# OpenRouter key — extra free-model fallback (also supports comma-separated keys)
# Get one: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — chat limits. Defaults shown.
# Questions per IP per minute (per server instance):
# RAG_RPM=12
# LLM-bound questions per UTC day, site-wide (shared through Redis when configured).
# Cached answers, small talk and refusals don't count; past it visitors get an honest "busy today":
# RAG_DAILY_MAX=1000
# Relevance gate: a question whose best knowledge-base match scores below this is refused
# with no LLM call. Lower = more permissive. Re-check with `npm run eval` after changing it:
# RAG_THRESHOLD=0.60

# ── Contact form ──────────────────────────────────────────────────────────────

# Contact form → Telegram. Create a bot with @BotFather to get the token, then
# send the bot a message and read your numeric chat id from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates  (result[].message.chat.id)
# The daily analytics digest reuses both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — messages per IP per 10 minutes (default 5). The admin login's in-memory
# limiter uses the same number, in its own buckets:
# CONTACT_MAX_PER_WINDOW=5

# ── Analytics + /admin (see docs/analytics.md) ────────────────────────────────

# Optional — Upstash Redis (REST). Powers the /admin visit analytics and makes the chat's
# daily cap shared across instances. Free tier: 256 MB, 500k commands per month, no credit
# card, and no idle pause. Easiest path: Vercel dashboard → Integrations (account sidebar)
# → Browse Marketplace → Upstash → Redis, then connect the database to this project; that
# injects the variables automatically. The app also reads KV_REST_API_URL/_TOKEN and
# prefixed names (<PREFIX>REST_API_URL/_TOKEN). Without them the site runs fine and
# analytics just no-ops.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Password for the /admin analytics dashboard. Unset = the page stays locked and says so.
# This single shared secret is the whole auth boundary — use a long RANDOM value, not a
# memorable phrase:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_PASSWORD=

# Optional — signing key for the 12-hour admin session cookie. When unset it is derived
# from ADMIN_PASSWORD via HKDF (never the password itself, so a leaked cookie can't be used
# to crack it), and changing the password signs everyone out. Set an explicit value if
# you'd rather sessions survive a password change. Removing ADMIN_PASSWORD always ends them.
# ADMIN_SESSION_SECRET=

# REQUIRED for the daily Telegram digest (/api/cron/digest). Vercel's cron sends it as
# `Authorization: Bearer <value>`; the route rejects anything else, and with no secret it
# rejects everything (fails closed), so the digest doesn't run until you set it. Any long
# random string. The digest stays silent on days with no visits.
# CRON_SECRET=

# Optional — analytics is written in production only. Set to 1 to record your own local
# `npm run dev` visits too (e.g. to test the pipeline against a dev database):
# ANALYTICS_IN_DEV=1

# Optional — abuse limits for the unauthenticated /api/track beacon and the admin login.
# Defaults shown.
# Accepted beacons per IP per minute (checked in memory, then shared through Redis):
# ANALYTICS_RPM=30
# Redis commands beacons may spend per UTC day (~360k/month of Upstash's free 500k):
# ANALYTICS_DAILY_COMMANDS=12000
# Admin login attempts per IP per hour, and site-wide per hour:
# ADMIN_LOGIN_MAX=10
# ADMIN_LOGIN_GLOBAL_MAX=500

# ── Site ──────────────────────────────────────────────────────────────────────

# Optional — canonical site URL for metadata / OG / sitemap. On Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which Vercel sets itself (don't add that one); set this
# explicitly once you point a custom domain.
# NEXT_PUBLIC_SITE_URL=https://sinaamareh.ir
